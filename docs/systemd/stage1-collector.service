[Unit]
Description=MAAS Stage1 diskless collector
After=network-online.target maas-offline-http.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/maas-offline/stage1-collector.env
ExecStart=/usr/bin/python3 /opt/maas-offline/stage1_collector.py serve --inventory ${STAGE1_INVENTORY} --defaults ${STAGE1_DEFAULTS} --state ${STAGE1_STATE} --host ${STAGE1_HOST} --port ${STAGE1_PORT}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
